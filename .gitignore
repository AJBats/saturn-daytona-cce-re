# Build artifacts
build/*
!build/save_states/
!build/save_states/*.mc0
!build/samples/
!build/samples/*
reimpl/build/

# Generated assembly scratch (root asm/ only). The seeder (gen_asm_shims.py)
# regenerates here; the TRACKED authentic shims live at src/race/asm/ and are
# NOT ignored (the leading slash anchors this rule to the repo root).
/asm/

*.o
*.elf
*.map
*.bin
*.BIN

# Disc images (large, copyrighted) — keep the folder, ignore contents
external_resources/*
!external_resources/.gitkeep
*.cue
*.bin
*.iso
*.img
*.mds
*.mdf

# Toolchain binaries and build temp
tools/sh-elf/
.setup-tmp/

# Archived one-off tools (kept locally for reference)
tools/archive/

# Claude session memory (auto-generated, not tracked)
.claude/memory/

# Python bytecode cache
__pycache__/
*.pyc

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
*.swp
*~
tools/cygnus-2.7-96Q3/

# Tracked sweep artifacts (override global *.bin / *.BIN ignores above).
# Irreproducible per-lap captures used as evidence for the dead-code
# census + per-track cross-reference work.
!workstreams/transplant/sweep_artifacts/**/*.bin

# Debug artifacts: saturn_log host-logging output, MCP screenshots
saturn_log.txt
mcp_screenshot.png
